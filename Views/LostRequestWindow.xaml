<Window x:Class="LostAndFoundAgency.Views.LostRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заява про втрату" Height="620" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F7F9">

    <Grid Margin="30,20,30,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="ЗАЯВА ПРО ВТРАТУ" FontSize="22" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Що ви загубили? (Назва)" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="14" Margin="0,5,0,16">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Категорія" FontWeight="SemiBold" Foreground="#34495E"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"
                          SelectedValue="{Binding SelectedCategoryId}"
                          Padding="8" FontSize="14" Margin="0,5,0,16"/>

                <TextBlock Text="Де приблизно втрачено" FontWeight="SemiBold" Foreground="#34495E"/>
                <ComboBox ItemsSource="{Binding Locations}"
                          DisplayMemberPath="LocationName"
                          SelectedValuePath="LocationId"
                          SelectedValue="{Binding SelectedLocationId}"
                          Padding="8" FontSize="14" Margin="0,5,0,16"/>

                <TextBlock Text="Детальний опис (колір, особливості, де приблизно)" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14" Margin="0,5,0,16">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Коли це сталося?" FontWeight="SemiBold" Foreground="#34495E"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,5,0,24" FontSize="14" Padding="5"/>

                <Button Content="ЗБЕРЕГТИ ЗАЯВКУ" Command="{Binding SaveCommand}" Padding="15" Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
