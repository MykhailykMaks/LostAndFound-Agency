<Window x:Class="LostAndFoundAgency.Views.ClientMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Особистий кабінет клієнта" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F4F7F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#3498DB">
            <DockPanel Margin="20,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ВІТАЄМО," Foreground="#AED6F1" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentClient.FullName}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                <Button Content="ВИЙТИ" Click="btnLogout_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="15,5" Background="Transparent" Foreground="White" BorderBrush="White"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="20" Background="Transparent" BorderThickness="0">
            <TabItem Header="МОЇ ЗАЯВКИ ПРО ВТРАТУ">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Command="{Binding ReportLostCommand}" HorizontalAlignment="Left" Margin="0,0,0,15" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#E74C3C"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="ЗАЯВИТИ ПРО ВТРАТУ"/>
                    </Button>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding MyLostRequests}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Річ" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateLost, StringFormat=d}" Width="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="МОЇ ЗНАХІДКИ">
                <Grid Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Command="{Binding ReportFoundCommand}" HorizontalAlignment="Left" Margin="0,0,0,15" Cursor="Hand" Foreground="White" FontWeight="Bold" FontSize="14">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2ECC71"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#27AE60"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="ЗАЯВИТИ ПРО ЗНАХІДКУ"/>
                    </Button>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding MyFoundItems}" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Що знайдено" Binding="{Binding ItemName}" Width="*"/>
                            <DataGridTextColumn Header="Де знаходиться" Binding="{Binding StorageLocation}" Width="200"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding DateFound, StringFormat=d}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>