<Window x:Class="LostAndFoundAgency.Views.EmployeeMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель керування бюро - Адміністратор" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#EEF2F5">
    <Window.Resources>
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="15,5,15,10"/>
        </Style>

        <Style x:Key="CleanGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#263545">
            <Grid>
                <StackPanel Margin="0,30,0,0">
                    <TextBlock Text="БЮРО ЗНАХІДОК" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Адміністрування бази" Foreground="#B8C7D6" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <Border Background="#33475C" Margin="15,0,15,20" Padding="15" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Режим роботи" Foreground="#9FB0C0" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Заявки, збіги, повернення, звіти" Foreground="White" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding GenerateDataCommand}" Style="{StaticResource PanelButton}" Background="#D97706">
                        <TextBlock Text="ЗГЕНЕРУВАТИ ДЕМО-ДАНІ"/>
                    </Button>

                    <Button Command="{Binding RefreshDataCommand}" Style="{StaticResource PanelButton}" Background="#2563EB">
                        <TextBlock Text="ОНОВИТИ ДАНІ З БД"/>
                    </Button>
                </StackPanel>

                <Button Content="Вийти з системи" Click="btnLogout_Click" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30" Background="Transparent" Foreground="#F87171" BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="Панель моніторингу бази даних" FontSize="26" FontWeight="Bold" Foreground="#263545"/>
                <TextBlock Text="Дані беруться з пов'язаних таблиць: заявки, знахідки, збіги, повернення, категорії та локації." FontSize="13" Foreground="#607083" Margin="0,4,0,0"/>
            </StackPanel>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                <TabItem Header="Авто-пошук збігів">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding PotentialMatches}" SelectedItem="{Binding SelectedMatch}" Style="{StaticResource CleanGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="140"/>
                                <DataGridTextColumn Header="Назва речі" Binding="{Binding ItemName}" Width="170"/>
                                <DataGridTextColumn Header="Дата втрати" Binding="{Binding LostDateStr}" Width="115"/>
                                <DataGridTextColumn Header="Дата знахідки" Binding="{Binding FoundDateStr}" Width="115"/>
                                <DataGridTextColumn Header="Деталі співставлення опису" Binding="{Binding DescriptionSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <TextBlock Text="Підтвердження створює записи у Matches та Returns" VerticalAlignment="Center" Foreground="#607083" Margin="0,0,15,0" FontStyle="Italic"/>
                            <Button Command="{Binding ConfirmMatchCommand}" Content="ПІДТВЕРДИТИ ВИДАЧУ РЕЧІ" Padding="20,12" Background="#16A34A" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Звіти БД">
                    <ScrollViewer Margin="0,15,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ReportMetrics}" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#607083" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="Bold" Foreground="#263545" Margin="0,5,0,2"/>
                                                <TextBlock Text="{Binding Note}" FontSize="11" Foreground="#8A99A8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Звіт по категоріях" Grid.Column="0" Margin="0,0,12,16" Padding="8">
                                    <DataGrid ItemsSource="{Binding CategoryReport}" Style="{StaticResource CleanGrid}" Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryName}" Width="*"/>
                                            <DataGridTextColumn Header="Втрати" Binding="{Binding LostCount}" Width="80"/>
                                            <DataGridTextColumn Header="Знахідки" Binding="{Binding FoundCount}" Width="80"/>
                                            <DataGridTextColumn Header="Повернено" Binding="{Binding ReturnedCount}" Width="85"/>
                                            <DataGridTextColumn Header="Баланс" Binding="{Binding ActiveBalance}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>

                                <GroupBox Header="Статуси заявок" Grid.Column="1" Margin="0,0,0,16" Padding="8">
                                    <DataGrid ItemsSource="{Binding StatusReport}" Style="{StaticResource CleanGrid}" Height="210">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="*"/>
                                            <DataGridTextColumn Header="Втрати" Binding="{Binding LostCount}" Width="70"/>
                                            <DataGridTextColumn Header="Знахідки" Binding="{Binding FoundCount}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>

                            <GroupBox Header="Журнал повернень речей" Padding="8">
                                <DataGrid ItemsSource="{Binding ReturnReport}" Style="{StaticResource CleanGrid}" Height="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата" Binding="{Binding ReturnDateStr}" Width="135"/>
                                        <DataGridTextColumn Header="Річ" Binding="{Binding ItemName}" Width="*"/>
                                        <DataGridTextColumn Header="Власник" Binding="{Binding OwnerName}" Width="160"/>
                                        <DataGridTextColumn Header="Співробітник" Binding="{Binding EmployeeName}" Width="160"/>
                                        <DataGridTextColumn Header="Документ" Binding="{Binding DocumentNumber}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Всі заяви про втрату">
                    <DataGrid Margin="0,15,0,0" ItemsSource="{Binding AllLostRequests}" Style="{StaticResource CleanGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding LostRequestId}" Width="50"/>
                            <DataGridTextColumn Header="Клієнт" Binding="{Binding Person.FullName}" Width="140"/>
                            <DataGridTextColumn Header="Категорія" Binding="{Binding Category.CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Локація" Binding="{Binding Location.LocationName}" Width="130"/>
                            <DataGridTextColumn Header="Назва речі" Binding="{Binding ItemName}" Width="150"/>
                            <DataGridTextColumn Header="Опис" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Дата втрати" Binding="{Binding DateLost, StringFormat=d}" Width="115"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Всі зареєстровані знахідки">
                    <DataGrid Margin="0,15,0,0" ItemsSource="{Binding AllFoundItems}" Style="{StaticResource CleanGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding FoundItemId}" Width="50"/>
                            <DataGridTextColumn Header="Заявник" Binding="{Binding Finder.FullName}" Width="140"/>
                            <DataGridTextColumn Header="Категорія" Binding="{Binding Category.CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Локація" Binding="{Binding Location.LocationName}" Width="130"/>
                            <DataGridTextColumn Header="Назва знахідки" Binding="{Binding ItemName}" Width="160"/>
                            <DataGridTextColumn Header="Місце зберігання" Binding="{Binding StorageLocation}" Width="160"/>
                            <DataGridTextColumn Header="Дата знахідки" Binding="{Binding DateFound, StringFormat=d}" Width="115"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

            </TabControl>
        </Grid>
    </Grid>
</Window>
