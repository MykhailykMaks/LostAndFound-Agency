<Window x:Class="LostAndFoundAgency.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бюро знахідок - Реєстрація" Height="550" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F2F5">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E0EAFC" Offset="0.0"/>
                <GradientStop Color="#CFDEF3" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Border CornerRadius="15" Background="White" Width="320" Height="480" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="#000" Opacity="0.15" ShadowDepth="5"/>
            </Border.Effect>

            <StackPanel Margin="25,25,25,25" VerticalAlignment="Top">
                <TextBlock Text="РЕЄСТРАЦІЯ" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="ПІБ" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="Name_PreviewTextInput" Padding="8" FontSize="14" Margin="0,0,0,10" BorderBrush="#BDC3C7" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Номер телефону" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="Phone_PreviewTextInput" PreviewKeyDown="BlockSpace_PreviewKeyDown" Padding="8" FontSize="14" Margin="0,0,0,10" BorderBrush="#BDC3C7" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Логін" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="LoginPass_PreviewTextInput" PreviewKeyDown="BlockSpace_PreviewKeyDown" Padding="8" FontSize="14" Margin="0,0,0,10" BorderBrush="#BDC3C7" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Пароль" FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="txtPasswordHidden" Padding="8" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1">
                        <PasswordBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5,0,0,5"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBox x:Name="txtPasswordVisible" Visibility="Collapsed" TextChanged="txtPasswordVisible_TextChanged" PreviewTextInput="LoginPass_PreviewTextInput" PreviewKeyDown="BlockSpace_PreviewKeyDown" Padding="8" FontSize="14" BorderBrush="#BDC3C7" BorderThickness="1">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="5,0,0,5"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <ToggleButton x:Name="btnTogglePassword" Grid.Column="1" Content="👁" Click="btnTogglePassword_Click" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,1,1,1" Cursor="Hand">
                        <ToggleButton.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="0,5,5,0"/>
                            </Style>
                        </ToggleButton.Resources>
                    </ToggleButton>
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" TextWrapping="Wrap" FontWeight="SemiBold"/>

                <Button Content="ЗАРЕЄСТРУВАТИСЯ" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=txtPasswordHidden}" Padding="10" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock HorizontalAlignment="Center" FontSize="13">
                    <Hyperlink x:Name="lnkBack" Click="lnkBack_Click" Foreground="#7F8C8D" FontWeight="SemiBold" TextDecorations="None">Повернутися до входу</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>