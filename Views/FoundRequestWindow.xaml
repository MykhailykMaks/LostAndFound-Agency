<Window x:Class="LostAndFoundAgency.Views.FoundRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Реєстрація знахідки" Height="690" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F7F9">

    <Grid Margin="30,20,30,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="РЕЄСТРАЦІЯ ЗНАХІДКИ" FontSize="22" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Що ви знайшли? (Назва)" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox Text="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="14" Margin="0,5,0,16">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Категорія" FontWeight="SemiBold" Foreground="#34495E"/>
                <ComboBox ItemsSource="{Binding Categories}"
                          DisplayMemberPath="CategoryName"
                          SelectedValuePath="CategoryId"
                          SelectedValue="{Binding SelectedCategoryId}"
                          Padding="8" FontSize="14" Margin="0,5,0,16"/>

                <TextBlock Text="Де знайшли" FontWeight="SemiBold" Foreground="#34495E"/>
                <ComboBox ItemsSource="{Binding Locations}"
                          DisplayMemberPath="LocationName"
                          SelectedValuePath="LocationId"
                          SelectedValue="{Binding SelectedLocationId}"
                          Padding="8" FontSize="14" Margin="0,5,0,16"/>

                <TextBlock Text="Опис (стан, особливі прикмети, де знайшли)" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="90" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" FontSize="14" Margin="0,5,0,16">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <TextBlock Text="Коли ви це знайшли?" FontWeight="SemiBold" Foreground="#34495E"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Margin="0,5,0,16" FontSize="14" Padding="5"/>

                <TextBlock Text="Де річ зараз? (У вас вдома, на охороні тощо)" FontWeight="SemiBold" Foreground="#34495E"/>
                <TextBox Text="{Binding StorageLocation, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="14" Margin="0,5,0,24">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <Button Content="ЗБЕРЕГТИ ЗНАХІДКУ" Command="{Binding SaveCommand}" Padding="15" Background="#2ECC71" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
